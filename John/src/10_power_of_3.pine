// ════════════════════════════════════════════════════════════════════════════════
// POWER OF 3 · ACCUMULATION, MANIPULATION, DISTRIBUTION (Spec 5.3)
// ════════════════════════════════════════════════════════════════════════════════
pipsText(float d) =>
    str.tostring(d / pipSize, "#.#") + pipUnit

po3Box(int l, float t, int r, float b, color col, string txt) =>
    box bx = box.new(left = l, top = t, right = r, bottom = b, xloc = xloc.bar_time,
         border_color = color.new(col, 30), border_width = 1, border_style = line.style_dashed,
         bgcolor = color.new(col, po3Fill), text = txt, text_size = boxTxtSz, text_color = col,
         text_halign = text.align_left, text_valign = text.align_top)
    po3Boxes.push(bx)
    if po3Boxes.size() > keepDays * 3
        box.delete(po3Boxes.shift())
    bx

// Redraws M and D from the day's extremes so far. The extreme that formed first after the true day
// open is the manipulation (Judas swing): a low first makes a bullish day (M below the open, D up to
// the high); a high first makes a bearish one. Both extremes on one candle: decided by where price
// now sits against the open. Until the true day window ends, both boxes are marked "developing".
po3Render(Po3State s) =>
    bool   bull = s.loT < s.hiT or (s.loT == s.hiT and close >= s.openPx)
    float  mExt = bull ? s.lo : s.hi
    int    mT   = bull ? s.loT : s.hiT
    float  dExt = bull ? s.hi : s.lo
    string live = s.cycLive ? "  (developing)" : ""
    string took = ""
    if bull
        if not na(s.refLo) and mExt < s.refLo
            took := took + " · took A low"
        if not na(s.pdLo) and mExt < s.pdLo
            took := took + " · took PDL"
    else
        if not na(s.refHi) and mExt > s.refHi
            took := took + " · took A high"
        if not na(s.pdHi) and mExt > s.pdHi
            took := took + " · took PDH"
    string mTxt = po3TxtM + (bull ? " ↓ Judas" : " ↑ Judas") + (po3Sizes ? "  " + pipsText(math.abs(s.openPx - mExt)) + took : "") + live
    string dTxt = po3TxtD + (bull ? " ↑" : " ↓") + (po3Sizes ? "  " + pipsText(math.abs(dExt - mExt)) : "") + live
    if po3M
        if na(s.bxM)
            s.bxM := po3Box(s.c0, math.max(s.openPx, mExt), mT, math.min(s.openPx, mExt), po3ColM, mTxt)
        else
            box.set_lefttop(s.bxM, s.c0, math.max(s.openPx, mExt))
            box.set_rightbottom(s.bxM, mT, math.min(s.openPx, mExt))
            box.set_text(s.bxM, mTxt)
    if po3D
        if na(s.bxD)
            s.bxD := po3Box(mT, math.max(mExt, dExt), s.c1, math.min(mExt, dExt), po3ColD, dTxt)
        else
            box.set_lefttop(s.bxD, mT, math.max(mExt, dExt))
            box.set_rightbottom(s.bxD, s.c1, math.min(mExt, dExt))
            box.set_text(s.bxD, dTxt)
    s

// One closed candle of Power of 3: grows the accumulation box during its window, then from the true
// day open tracks the day's high and low (with their times) and redraws M and D. A window is only
// started on its first candle, so a chart that loads mid-window waits for the next day.
po3Step(Po3State s, bool inAccNow, bool accStarts, bool inCycNow, bool cycStarts) =>
    if inAccNow and (s.accLive or accStarts)
        if not s.accLive
            s.accLive := true
            s.accHi   := high
            s.accLo   := low
            s.bxA     := na
            if po3A
                [t0, t1] = sessWindow(po3Acc)
                s.bxA := po3Box(t0, high, t1, low, po3ColA, po3TxtA)
        else
            s.accHi := math.max(s.accHi, high)
            s.accLo := math.min(s.accLo, low)
        if not na(s.bxA)
            box.set_top(s.bxA, s.accHi)
            box.set_bottom(s.bxA, s.accLo)
            box.set_text(s.bxA, po3TxtA + (po3Sizes ? "  " + pipsText(s.accHi - s.accLo) : ""))
    else if s.accLive
        s.accLive := false
    if inCycNow and (s.cycLive or cycStarts)
        if not s.cycLive
            [c0, c1] = sessWindow(po3Cycle)
            s.cycLive := true
            s.c0      := c0
            s.c1      := c1
            s.openPx  := open
            s.hi      := high
            s.lo      := low
            s.hiT     := time
            s.loT     := time
            s.refHi   := s.accHi
            s.refLo   := s.accLo
            s.pdHi    := pdHiVal
            s.pdLo    := pdLoVal
            s.bxM     := na
            s.bxD     := na
            if po3OpenLn
                po3Lines.push(line.new(x1 = c0, y1 = open, x2 = c1, y2 = open, xloc = xloc.bar_time,
                     color = color.new(color.gray, 30), style = line.style_dotted, width = 1))
                if po3Lines.size() > keepDays
                    line.delete(po3Lines.shift())
        else
            if high > s.hi
                s.hi  := high
                s.hiT := time
            if low < s.lo
                s.lo  := low
                s.loT := time
        po3Render(s)
    else if s.cycLive
        s.cycLive := false
        po3Render(s)
    s

